/ {
    aliases {
        can0 = &twai;
    };
};

&pinctrl {
    twai_default: twai_default {
        group1 {
            pinmux = <TWAI_TX_GPIO26>, <TWAI_RX_GPIO25>;
        };
    };
};

&twai {
    status = "okay";
    pinctrl-0 = <&twai_default>;
    pinctrl-names = "default";
    bus-speed = <125000>;
};

&wifi {
    status = "okay";
};
