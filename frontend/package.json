{
  "name": "wireless-uploader",
  "displayName": "WirelessUploader",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wirelessUploaderViewContainer",
          "title": "Wireless Boards",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wirelessUploaderViewContainer": [
        {
          "id": "wirelessUploaderBoardView",
          "name": "Wireless Boards",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "wirelessUploader.addSystem",
        "title": "Add System",
        "icon": "$(add)"
      },
      {
        "command": "wirelessUploader.removeSystem",
        "title": "Remove System",
        "icon": "$(trash)"
      },
      {
        "command": "wirelessUploader.uploadToBoard",
        "title": "Upload",
        "icon": "$(cloud-upload)"
      }

    ],
    "menus": {
        "view/title": [
          {
            "command": "wirelessUploader.addSystem",
            "when": "view == wirelessUploaderBoardView",
            "group": "navigation"
          }
        ],
        "view/item/context": [
          {
            "command": "wirelessUploader.removeSystem",
            "when": "view == wirelessUploaderBoardView && viewItem == system",
            "group": "inline@1"
          },
          {
            "command": "wirelessUploader.uploadToBoard",
            "when": "view == wirelessUploaderBoardView && viewItem == board",
            "group": "inline@1"
          }
        ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
